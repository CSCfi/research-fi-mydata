{
    "description": "A data exchange format used to determine whether a person has granted a valid consent for the transfer of their Research.fi profile data to a specified controller. The response returns the current consent status or indicates that no profile exists for the person or that the specified controller is not registered in the system.",
    "id": "https://iri.suomi.fi/model/researchfi_profile_consent/1.0.0/",
    "type": "object",
    "title": "Research.fi - profile data transfer consent status query and response",
    "properties": {
        "identifier": {
            "description": "",
            "type": "object",
            "title": "Persistent identifier information",
            "required": [
                "pidType",
                "pidContent"
            ],
            "properties": {
                "pidContent": {
                    "description": "",
                    "type": "string",
                    "title": "pidContent"
                },
                "pidType": {
                    "description": "",
                    "title": "pidType",
                    "enum": [
                        "ORCID",
                        "HETU"
                    ]
                }
            }
        },
        "response_for_consent_status": {
            "description": "",
            "type": "object",
            "title": "Response for consent",
            "required": [
                "consentManagementURL",
                "profileFound",
                "controllerFound"
            ],
            "properties": {
                "profileFound": {
                    "description": "",
                    "title": "profileFound",
                    "type": "boolean"
                },
                "controllerFound": {
                    "description": "",
                    "title": "controllerFound",
                    "type": "boolean"
                },
                "profileData": {
                    "description": "",
                    "title": "profileData",
                    "$ref": ""
                },
                "consentActive": {
                    "description": "Indicates whether an active consent exists between the identified person and the specified controller. Returned only when both the controller and the profile are found.",
                    "title": "consentActive",
                    "type": "boolean"
                },
                "consentManagementURL": {
                    "description": "",
                    "title": "consentManagementURL",
                    "$ref": "#/properties/language_variant"
                }
            }
        },
        "language_variant": {
            "description": "",
            "type": "object",
            "title": "Language variants",
            "properties": {
                "sv": {
                    "description": "",
                    "type": "string",
                    "title": "sv"
                },
                "fi": {
                    "description": "",
                    "type": "string",
                    "title": "fi"
                },
                "en": {
                    "description": "",
                    "type": "string",
                    "title": "en"
                }
            }
        },
        "query_for_consent_status": {
            "description": "",
            "type": "object",
            "title": "Query for consent status",
            "required": [
                "personIdentifiers",
                "controllerROR"
            ],
            "properties": {
                "controllerROR": {
                    "description": "",
                    "type": "string",
                    "title": "controllerROR"
                },
                "personIdentifiers": {
                    "minItems": 1,
                    "maxItems": 2,
                    "description": "'Hetu', 'ORCID'",
                    "type": "array",
                    "title": "personIdentifiers",
                    "items": [{
                        "description": "'Hetu', 'ORCID'",
                        "title": "personIdentifiers",
                        "$ref": "#/properties/identifier"
                    }]
                }
            }
        }
    }
}